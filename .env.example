# --- Database (Neon, pooled connection string) -----------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- LLM provider abstraction (PLAN.md §14) - swap by changing this + one adapter ---
LLM_PROVIDER=gemini

# --- Gemini, project A "idioma-free" (NEVER link billing to this project) --
GEMINI_API_KEY=
GEMINI_LESSON_MODEL=gemini-3.6-flash

# --- Google Cloud project B "idioma-cloud" (billed; TTS free allotment) -----
# API key restricted to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=

# --- Auth.js (Phase 2) -------------------------------------------------------
# Generate AUTH_SECRET with: npx auth secret  (any 32-byte random string works)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Gamification (Phase 4B, PLAN.md §12.2) -----------------------------------
# Set to 'true' once both beta users are onboarded to show the couple-streak line
# on the dashboard. Leave unset/false otherwise.
SHOW_PARTNER_STREAK=false

# --- Future upgrade only (true real-time Live mode, PLAN.md §4.2; unused) ---
# GEMINI_LIVE_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
