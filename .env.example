# --- Database (Neon, pooled connection string) -----------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- LLM provider + model (PLAN.md §14) --------------------------------------
# These two are only the FALLBACK used before anything is chosen in /admin. Once an
# admin saves a selection there it is stored in the database and wins over these,
# so switching models is a click, not a redeploy.
LLM_PROVIDER=gemini

# --- Gemini, project A "idioma-free" (NEVER link billing to this project) --
GEMINI_API_KEY=
GEMINI_LESSON_MODEL=gemini-3.6-flash

# --- OpenAI (optional; only needed if you switch a task to OpenAI in /admin) --
# NOTE: OpenAI's chat models can't take the recording directly, so a spoken turn
# costs two calls (transcribe, then feedback) and yields NO pronunciation feedback.
# Gemini is the better fit for a speaking app; this exists so the choice is yours.
OPENAI_API_KEY=
# Comma-separated model IDs to offer in /admin's dropdown. Optional - you can also
# just type a model ID into the admin page. No IDs are hardcoded in the app, because
# provider model names churn (PLAN.md §10.7). Copy exact IDs from OpenAI's docs.
OPENAI_FEEDBACK_MODELS=
# Pre-selects a model/transcription model before anything is saved in /admin.
OPENAI_FEEDBACK_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# Override the API base URL (self-hosted gateway / proxy). Optional.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Cloud project B "idioma-cloud" (billed; TTS free allotment) -----
# API key restricted to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=

# --- Auth.js (Phase 2) -------------------------------------------------------
# Generate AUTH_SECRET with: npx auth secret  (any 32-byte random string works)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Tier gate (PLAN.md §15.3) ------------------------------------------------
# Comma-separated emails that `npm run db:seed` promotes to tier='premium'. The tier
# column gates expensive practice modes server-side; it is NOT billing, and there is
# no client-visible flag. Both beta users belong here. A user must have signed in at
# least once (that is what creates their row) before the promotion can find them.
# Equivalent by hand: UPDATE users SET tier = 'premium' WHERE email = '...';
PREMIUM_USER_EMAILS=

# --- Gamification (Phase 4B, PLAN.md §12.2) -----------------------------------
# Set to 'true' once both beta users are onboarded to show the couple-streak line
# on the dashboard. Leave unset/false otherwise.
SHOW_PARTNER_STREAK=false

# --- Future upgrade only (true real-time Live mode, PLAN.md §4.2; unused) ---
# GEMINI_LIVE_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
